# Publish only the source tree and code documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/requirements-baselines.txt
!/requirements-optional.txt
!/LICENSE*
!/NOTICE*
!/.github/
!/compare/
!/configs/
!/datasets/
!/docs/
!/models/
!/scripts/
!/tests/
!/tools/
!/utils/

# Python and native builds
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
build/
dist/
*.egg-info/
*.so
*.o
*.a
.venv/
venv/

# Workstation settings and credentials
/local/
/.vscode/
/.idea/
/.agents/
/.codex/
/.aws/
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
Thumbs.db
*~
*.bak
*.orig

# Data, weights, generated evidence and logs
/data/
/runs/
/outputs/
/results/
/checkpoints/
/cache/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.npy
*.tif
*.tiff
*.nc
*.log
*.zip
*.tar
*.tar.gz
*.xlsx
*.xls
.tensorboard-info/
wandb/

