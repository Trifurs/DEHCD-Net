**/runs/
**/outputs/
**/results/
**/checkpoints/
**/cache/
**/logs/
**/backup/
*.csv
*.tsv
*.jsonl
*.ods
*.parquet
*.pkl
*.pickle
*.docx
*.pdf
*.pptx
*.tmp
*.npz
!/compare/official/wavehfg/pytorch_wavelets/dtcwt/data/*.npz
**/result.json
**/aggregate.json
