    <device type="str">cuda:0</device>
    <epochs type="int">100</epochs>
    <batch_size type="int">8</batch_size>
    <num_workers type="int">8</num_workers>
    <persistent_workers type="bool">true</persistent_workers>
    <augmentation_seed_mode type="str">sample_draw</augmentation_seed_mode>
    <prefetch_factor type="int">3</prefetch_factor>
    <cpu_threads type="int">8</cpu_threads>
    <allow_tf32 type="bool">true</allow_tf32>
