<?xml version="1.0" encoding="UTF-8"?>
<project>
  <base_param type="path">base.xml</base_param>
  <task>
    <name type="str">earthquake_damage_transfer</name>
    <type type="str">multiclass_damage_change_detection</type>
    <num_classes type="int">4</num_classes>
    <class_names type="list">["background", "intact", "damaged", "destroyed"]</class_names>
  </task>
  <dataset>
    <type type="str">event_transfer</type>
    <name type="str">EventTransferEarthquake</name>
    <root type="path">data/event_transfer_earthquake</root>
